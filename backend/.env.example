
# ---------------------------------------------------------------------------
# SerpApi real-time web search (optional — enables regulatory query grounding)
# ---------------------------------------------------------------------------
# When set, Mike searches selectively for fresh/current information and explicit
# web-research requests. Confidential prompts are never sent verbatim; explicit
# searches over confidential text use public regulatory/legal topic terms only.
#
# Obtain your key at: https://serpapi.com/
# Add via Railway -> Settings -> Variables -> SERPAPI_KEY
# Leave unset to disable — Mike continues normally using Fugu training data.
# SERPAPI_KEY=your-serpapi-key
# SERP_SEARCH_MODE=selective
# SERPAPI_MAX_SEARCHES_PER_MINUTE=30
PORT=3001
FRONTEND_URL=http://localhost:3000

# HMAC key used to sign /download/:token URLs. Required at startup.
# Generate with: openssl rand -hex 32
# Use a dedicated secret distinct from SUPABASE_SECRET_KEY.
DOWNLOAD_SIGNING_SECRET=replace-with-a-random-32-byte-hex-string
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=mike

GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
# Optional: xAI Grok (selectable in chat; fifth legal-council seat).
# Not in the default chat fallback chain. Client base URL is https://api.x.ai/v1.
# Obtain a key at https://console.x.ai/
# XAI_API_KEY=your-xai-key
RESEND_API_KEY=your-resend-key
USER_API_KEYS_ENCRYPTION_SECRET=your-long-random-secret

# Optional: enables higher-rate CourtListener case law/citation lookup tools.
COURTLISTENER_API_TOKEN=your-courtlistener-token

# ---------------------------------------------------------------------------
# Sakana Fugu LLM (required — server will refuse to start without SAKANA_API_KEY)
# ---------------------------------------------------------------------------
# All LLM calls are routed through Sakana Fugu. Obtain your key at:
# https://sakana.ai/fugu/
# Add via your hosting provider's secrets manager (e.g. Railway → Settings → Variables).
# NEVER commit the actual key to the repository.
# SAKANA_API_KEY=your-sakana-key

# Sakana API base URL — override only if routing through a private/proxy endpoint.
# Default: https://api.sakana.ai/v1
# SAKANA_BASE_URL=https://api.sakana.ai/v1

# Fugu variant used only when a Sakana model is actually invoked (council, or
# an explicit LLM_MODEL / LLM_FALLBACK_MODEL hop). Does NOT set the chat primary.
# Default: fugu-ultra-20260615
# SAKANA_MODEL=fugu-ultra-20260615

# Chat routing. Default chain (no Fugu): claude-fable-5-1 → claude-opus-5 → gpt-6-astra
# LLM_MODEL=claude-fable-5-1
# LLM_FALLBACK_MODEL=claude-opus-5,gpt-6-astra

# Mandatory 5/5 legal council seats. Every named model must answer; there is no
# model substitution. Anthropic seat is Fable 5.1; GPT-6 Astra runs with xhigh
# reasoning; xAI seat is Grok 4.6. Railway must set
# COUNCIL_ANTHROPIC_MODEL=claude-fable-5-1, COUNCIL_OPENAI_MODEL=gpt-6-astra,
# and COUNCIL_XAI_MODEL=grok-4.6 on deploy (Platform Engineer / CoS).
# Switch COUNCIL_GEMINI_MODEL and its label only after Google publishes and the
# account can successfully call the exact Gemini 3.5 Pro API identifier.
# COUNCIL_ANTHROPIC_MODEL=claude-fable-5-1
# COUNCIL_SAKANA_MODEL=fugu-ultra-20260615
# COUNCIL_OPENAI_MODEL=gpt-6-astra
# COUNCIL_GEMINI_MODEL=gemini-3.1-pro-preview
# COUNCIL_GEMINI_LABEL=Gemini 3.1 Pro Preview
# COUNCIL_XAI_MODEL=grok-4.6
# COUNCIL_MEMBER_MAX_ATTEMPTS=3
# COUNCIL_RETRY_BASE_DELAY_MS=1500
# COUNCIL_ANTHROPIC_MAX_TOKENS=8000
# COUNCIL_SAKANA_MAX_TOKENS=6000
# COUNCIL_OPENAI_MAX_TOKENS=16384
# COUNCIL_GEMINI_MAX_TOKENS=6000
# COUNCIL_XAI_MAX_TOKENS=8000
# Neutral judge (not a voting seat). Default Opus 5; adaptive thinking needs a
# larger output budget than 8k to avoid truncating the reconciled opinion.
# COUNCIL_JUDGE=claude-opus-5
# COUNCIL_JUDGE_MAX_TOKENS=16000
