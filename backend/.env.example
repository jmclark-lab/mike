
# ---------------------------------------------------------------------------
# SerpApi real-time web search (optional — enables regulatory query grounding)
# ---------------------------------------------------------------------------
# When set, Mike searches selectively for fresh/current information and explicit
# web-research requests. Confidential prompts are never sent verbatim; explicit
# searches over confidential text use public regulatory/legal topic terms only.
#
# Obtain your key at: https://serpapi.com/
# Add via Railway -> Settings -> Variables -> SERPAPI_KEY
# Leave unset to disable — Mike continues normally with the configured providers.
# SERPAPI_KEY=your-serpapi-key
# SERP_SEARCH_MODE=selective
# SERPAPI_MAX_SEARCHES_PER_MINUTE=30
PORT=3001
FRONTEND_URL=http://localhost:3000

# Word tracked-change author used when the acting user has no organisation
# on their profile (Account → organisation). That profile field is the
# per-tenant company voice and wins over this value. Set it per account
# (Account page, or backend/src/scripts/bootstrapOrganisation.ts). Do not
# overwrite a company name that is already stored. Banned labels
# (Mike, AI, Legal AI, and similar) are ignored and rejected on save.
# If both organisation and this value are missing or banned, new redlines
# are authored as "Author" — never Mike or AI.
# Client-facing Word/PDF downloads scrub known disclosure phrases and then
# fail closed if any Mike/AI attribution remains.
# TRACKED_CHANGE_AUTHOR=
# HMAC key used to sign /download/:token URLs. Required at startup.
# Generate with: openssl rand -hex 32
# Use a dedicated secret distinct from SUPABASE_SECRET_KEY.
DOWNLOAD_SIGNING_SECRET=replace-with-a-random-32-byte-hex-string
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=mike

GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
# Optional: xAI Grok 4.7 (fourth legal-council seat; selectable in chat).
# Not in the default chat fallback chain. Client base URL is https://api.x.ai/v1.
# Obtain a key at https://console.x.ai/
# XAI_API_KEY=your-xai-key
# Optional: DeepSeek adapter. Not offered in the CI-facing model picker.
# Not in the default chat fallback chain. Not a legal-council seat.
# OpenAI-compatible Chat Completions at https://api.deepseek.com.
# DEEPSEEK_API_KEY=your-deepseek-key
RESEND_API_KEY=your-resend-key
USER_API_KEYS_ENCRYPTION_SECRET=your-long-random-secret

# Optional: enables higher-rate CourtListener case law/citation lookup tools.
COURTLISTENER_API_TOKEN=your-courtlistener-token

# ---------------------------------------------------------------------------
# Sakana Fugu — optional and unused by council and chat
# ---------------------------------------------------------------------------
# SAKANA_API_KEY is not required. The server boots without it. Council and the
# default chat chain do not call api.sakana.ai. A leftover value is ignored by
# startup. Do not commit a real key.
# SAKANA_API_KEY=
# SAKANA_BASE_URL and SAKANA_MODEL are not read by council or the chat chain.

# Sponsor-CI mode. Off by default. Set to 1 on the backend process to fence
# Sakana and DeepSeek out of chat, council, and the judge even when API keys
# exist, lock council/judge to Fable 5.1, Opus 5.5, GPT-6 Astra, Gemini 3.1
# Pro Preview, and Grok 4.7, and stop plain-text or renamed downloads from
# skipping the fail-closed export attribution gate. There is no organisation
# settings column; this flag is process-wide. The profile response echoes it
# so the model picker hides fugu- and deepseek- ids. Optionally set
# NEXT_PUBLIC_SPONSOR_CI_MODE=1 on the frontend build so the picker is fenced
# before the profile loads. The docx/PDF gate stays on even when this is unset.
# SPONSOR_CI_MODE=1

# Chat routing. Default chain: claude-fable-5-1 → claude-opus-5-5 → gpt-6-astra
# Fugu ids in LLM_MODEL or LLM_FALLBACK_MODEL are dropped.
# LLM_MODEL=claude-fable-5-1
# LLM_FALLBACK_MODEL=claude-opus-5-5,gpt-6-astra

# 4-seat legal council. Every named model is convened; there is no model
# substitution and no Sakana seat. Judge runs after COUNCIL_MIN_QUORUM
# successful opinions (default 4, clamp 1–4). Seats: Fable 5.1, GPT-6 Astra
# (xhigh reasoning), Gemini 3.1 Pro Preview, Grok 4.7. Judge is Opus 5.5 and
# is not a voting seat.
# COUNCIL_ANTHROPIC_MODEL=claude-fable-5-1
# COUNCIL_OPENAI_MODEL=gpt-6-astra
# COUNCIL_GEMINI_MODEL=gemini-3.1-pro-preview
# COUNCIL_GEMINI_LABEL=Gemini 3.1 Pro Preview
# COUNCIL_XAI_MODEL=grok-4.7
# COUNCIL_MEMBER_MAX_ATTEMPTS=3
# COUNCIL_RETRY_BASE_DELAY_MS=1500
# COUNCIL_MIN_QUORUM=4
# COUNCIL_ANTHROPIC_MAX_TOKENS=32000
# COUNCIL_OPENAI_MAX_TOKENS=16384
# COUNCIL_GEMINI_MAX_TOKENS=6000
# COUNCIL_XAI_MAX_TOKENS=8000
# Chat orchestrator (Fable 5.1 stream + adaptive thinking). Thinking tokens
# count against this budget; 16k was enough to emit an intake preamble and
# then stop_reason=max_tokens without convene_council. Default 32000 matches
# the Fable council seat.
# CLAUDE_CHAT_MAX_TOKENS=32000
# Neutral judge (not a voting seat). Default Opus 5.5; adaptive thinking needs a
# larger output budget than 8k to avoid truncating the reconciled opinion.
# COUNCIL_JUDGE=claude-opus-5-5
# COUNCIL_JUDGE_MAX_TOKENS=16000
