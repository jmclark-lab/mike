NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Production frontend builds are expected to set NEXT_PUBLIC_SPONSOR_CI_MODE=1
# so the model picker hides fugu- and deepseek- ids before /user/profile loads.
# Next.js inlines NEXT_PUBLIC_* at build time. It does not refuse a model call.
# The backend SPONSOR_CI_MODE flag is the authority. Leave unset for local dev.
# NEXT_PUBLIC_SPONSOR_CI_MODE=1
